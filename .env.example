# Gateway (src/personal.ts). Workspace settings: src/workspace/config.ts.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DATABASE_PATH=./data/personal.db

# Optional: skip digitally silent recordings before paid transcription. Default off.
# This does not detect speech in background noise. Requires ffmpeg (included in Docker).
# TRANSCRIPTION_SKIP_SILENCE=1
# TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Optional: enables the proxied web_search tool (https://exa.ai)
EXA_API_KEY=

# Optional: path to the identity registry (default: ./principals.json). If the file is
# missing/empty, OWNER_DISCORD_ID synthesizes a single owner principal instead.
# PRINCIPALS_PATH=./principals.json
# OWNER_DISCORD_ID=

# Optional: team grouping (default: ./teams.json), routes Linear issues per team.
# TEAMS_PATH=./teams.json

# Workspace transport.
# ORCH_PORT=8788
# ORCH_SECRET=
# DM_WORKSPACE_ENABLED=true

# Web gateway. Empty WEB_OWNER_LOGIN keeps it off.
# WEB_OWNER_LOGIN=
# WEB_PORT=8790
# WEB_DEV_LOGIN=

# Optional: add connectors to the enabled features of a configured web gateway.
# WEB_FEATURES=runs,history,home,alerts,connectors

# Optional: owner web live voice. Separate API billing; no ChatGPT subscription credential.
# Qwen also requires its workspace ID; the key and workspace must match the region.
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_REGION=ap-southeast-1
# GEMINI_API_KEY=
# OPENAI_REALTIME_API_KEY=
# QWEN_VOICE=Tina
# GEMINI_VOICE=Kore
# OPENAI_REALTIME_VOICE=marin

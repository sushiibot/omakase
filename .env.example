DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.anthropic.com/v1
OPENAI_MODEL=claude-opus-4-6
DATABASE_PATH=./data/sushii-agent.db

# Set to true once the privileged Message Content intent is approved. Default off.
# DISCORD_MESSAGE_CONTENT=true

# Optional: skip digitally silent recordings before paid transcription. Default off.
# This does not detect speech in background noise. Requires ffmpeg (included in Docker).
# TRANSCRIPTION_SKIP_SILENCE=1
# TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Optional: enables the web_search tool (https://exa.ai)
EXA_API_KEY=

# Optional: path to the manual cross-platform identity registry (default: ./principals.json).
# Maps a principal → its per-surface user ids. If the file is missing/empty, OWNER_DISCORD_ID is
# used to synthesize a single owner principal from it instead.
# PRINCIPALS_PATH=./principals.json

# Path to the team grouping config (default: ./teams.json) — the only source of per-space
# configuration (Discord guild, Slack workspace, buzz relay). See teams.example.json and the
# README's Configuration reference for the shape of an entry.
# TEAMS_PATH=./teams.json

# Optional: add connectors to the enabled features of a configured web gateway.
# WEB_FEATURES=runs,history,home,alerts,connectors

# Optional: owner web live voice. Separate API billing; no ChatGPT subscription credential.
# Qwen also requires its workspace ID; the key and workspace must match the region.
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_REGION=ap-southeast-1
# GEMINI_API_KEY=
# OPENAI_REALTIME_API_KEY=
# QWEN_VOICE=Tina
# GEMINI_VOICE=Kore
# OPENAI_REALTIME_VOICE=marin
